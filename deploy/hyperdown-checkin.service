[Unit]
Description=Hyperdown daily check-in
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hyperdown
Group=hyperdown
WorkingDirectory=/opt/hyperdown-checkin
EnvironmentFile=-/etc/hyperdown-checkin.env
ExecStart=/opt/hyperdown-checkin/.venv/bin/python /opt/hyperdown-checkin/checkin.py
# 0=成功或今日已签到；非 0 见 journalctl / logs/checkin.log
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
