# 复制到服务器：
#   sudo cp deploy/env.example /etc/hyperdown-checkin.env
#   sudo chmod 600 /etc/hyperdown-checkin.env
#   sudo nano /etc/hyperdown-checkin.env
#
# 说明：文件由 root 持有 600，systemd 以 root 读取后 drop 到 User=hyperdown。
# 手动试跑请用：sudo systemctl start hyperdown-checkin.service

HYPERDOWN_EMAIL=you@example.com
HYPERDOWN_PASSWORD=your-password

# 可选
# HYPERDOWN_API_BASE=https://hyperdown.net
# HYPERDOWN_PROXY=http://127.0.0.1:7890
# 默认已与官方客户端一致，一般无需设置：
# HYPERDOWN_USER_AGENT=Go-http-client/1.1

# 以下仅调试用；生产环境请保持注释（代码内默认已通过服务端校验）
# HYPERDOWN_KDF_VARIANT=ecdh_re_primary
# HYPERDOWN_SIGN_VARIANT=v3_token_nul
# HYPERDOWN_B64_VARIANT=rawurl
# HYPERDOWN_SIGN_SEP=nul
# 覆盖内嵌对端 X25519 公钥（hex，非账号密钥）：
# HYPERDOWN_SECURE_PEER_PUB=
