# 复制到服务器：
#   sudo cp deploy/env.example /etc/hyperdown-checkin.env
#   sudo chmod 600 /etc/hyperdown-checkin.env
#   sudo nano /etc/hyperdown-checkin.env

HYPERDOWN_EMAIL=you@example.com
HYPERDOWN_PASSWORD=your-password

# 可选
# HYPERDOWN_API_BASE=https://hyperdown.net
# HYPERDOWN_PROXY=http://127.0.0.1:7890
# HYPERDOWN_USER_AGENT=Mozilla/5.0 Hyperdown/3.0

# 安全封包调试（签到仍 invalid 时再改）
# HYPERDOWN_KDF_VARIANT=salt_digest_info_prefix_method_path
# HYPERDOWN_WIRE_VARIANT=nonce_hex_ct_b64_with_nonce
